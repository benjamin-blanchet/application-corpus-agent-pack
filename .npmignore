# Repo-only assets — not part of the installable pack, and never copied into a
# consumer repo (also enforced by the denylist in scripts/lib/upgrade-core.mjs).
docs/
.github/workflows/

# Repository development specs are not consumer scaffolds. Keep only the
# reusable template in the installable pack.
doc/spec/*
!doc/spec/template/
!doc/spec/template/**
