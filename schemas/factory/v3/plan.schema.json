{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://application-corpus.dev/schemas/factory/v3/plan.schema.json",
  "title": "Software Factory V3 execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "spec_path", "acceptance_criteria", "lots"],
  "properties": {
    "v": { "const": 3 },
    "spec_path": { "type": "string", "minLength": 1 },
    "environment_contract": { "type": ["string", "null"] },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "proved_by"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "proved_by": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
        }
      }
    },
    "lots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lot" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["exact", "prefix"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "invariants", "non_goals"],
      "properties": {
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "non_goals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "objective", "acceptance_criteria", "dependencies", "read_claims", "write_claims", "forbidden_paths", "contracts", "handoff", "verification", "stop_rules", "risk", "control_plane_critical", "complexity", "agent_role", "model_role", "capabilities", "decision_domains", "max_attempts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": { "const": "implementation" },
        "objective": { "type": "string", "minLength": 1 },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "read_claims": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "minItems": 1 },
        "write_claims": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "minItems": 1 },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } },
        "contracts": { "$ref": "#/$defs/contracts" },
        "handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs", "include_private_reasoning"],
          "properties": {
            "inputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "path", "sha256"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            },
            "outputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "path"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "minLength": 1 }
                }
              }
            },
            "include_private_reasoning": { "const": false }
          }
        },
        "verification": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "stop_rules": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "risk": { "enum": ["low", "medium", "high"] },
        "control_plane_critical": { "type": "boolean" },
        "complexity": { "enum": ["bounded", "reasoning"] },
        "agent_role": { "enum": ["implementer", "migration"] },
        "model_role": { "enum": ["economy", "standard", "expert"] },
        "capabilities": {
          "type": "array",
          "items": { "enum": ["read", "write", "execute", "network", "data_mutation"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "decision_domains": { "type": "array", "items": { "enum": ["business", "architecture", "security", "migration"] }, "uniqueItems": true },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    }
  }
}
