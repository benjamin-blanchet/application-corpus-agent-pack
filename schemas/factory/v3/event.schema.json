{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://application-corpus.dev/schemas/factory/v3/event.schema.json",
  "title": "Software Factory V3 event",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "run_id", "seq", "event_id", "type", "at", "controller_id", "expected_previous_seq", "previous_event_sha256", "actor", "subject", "basis", "data"],
  "properties": {
    "v": { "const": 3 },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "seq": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "pattern": "^EVT-[0-9]{6,}$" },
    "type": {
      "enum": [
        "package_initialized", "legacy_v1_imported", "spec_proposed", "spec_approved", "plan_proposed", "plan_approved", "execution_policy_resolved",
        "lot_conventions_observed", "wave_reserved", "attempt_budget_extended", "diff_budget_overridden", "refactor_approved", "lot_started", "lot_result_reported", "lot_reviewed", "lot_integrated", "lot_blocked", "reservation_released",
        "integration_verified", "consolidated_reviewed", "corpus_closed", "candidate_frozen", "acceptance_started", "acceptance_completed", "acceptance_waived",
        "evidence_committed", "release_reviewed", "draft_pr_planned", "draft_pr_created", "artifact_change_observed", "controller_recovery_approved"
      ]
    },
    "at": { "type": "string", "format": "date-time" },
    "controller_id": { "type": "string", "minLength": 1 },
    "expected_previous_seq": { "type": "integer", "minimum": 0 },
    "previous_event_sha256": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/sha256" }] },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["role", "execution_id", "model", "capabilities"],
      "properties": {
        "role": { "enum": ["controller", "implementer", "reviewer", "acceptance", "delivery", "migration"] },
        "execution_id": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["read", "write", "execute", "network", "open_pr", "data_mutation"] } },
        "capability_grants": {
          "description": "Reserved for a future machine-verifying isolated-executor integration. The shipped V3 control plane accepts only an empty array and never treats approvals, environment gates or receipt strings as grants.",
          "type": "array",
          "maxItems": 0
        },
        "model": { "type": "object", "additionalProperties": false, "required": ["planned", "requested", "used", "model_family"], "properties": { "planned": { "type": ["string", "null"] }, "requested": { "type": ["string", "null"] }, "used": { "type": ["string", "null"] }, "model_family": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" } } }
      }
    },
    "subject": { "type": "object", "additionalProperties": false, "required": ["package", "lot_id"], "properties": { "package": { "type": "string", "minLength": 1 }, "lot_id": { "type": ["string", "null"] } } },
    "basis": { "type": "object", "additionalProperties": false, "properties": { "spec_sha256": { "$ref": "#/$defs/nullableSha256" }, "plan_sha256": { "$ref": "#/$defs/nullableSha256" }, "candidate_sha": { "$ref": "#/$defs/nullableGitSha" }, "diff_sha256": { "$ref": "#/$defs/nullableSha256" } } },
    "data": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/eventPackageInitialized" }, { "$ref": "#/$defs/eventLegacyV1Imported" },
    { "$ref": "#/$defs/eventSpecProposed" }, { "$ref": "#/$defs/eventSpecApproved" }, { "$ref": "#/$defs/eventPlanProposed" }, { "$ref": "#/$defs/eventPlanApproved" },
    { "$ref": "#/$defs/eventExecutionPolicyResolved" }, { "$ref": "#/$defs/eventLotConventionsObserved" }, { "$ref": "#/$defs/eventWaveReserved" }, { "$ref": "#/$defs/eventAttemptBudgetExtended" }, { "$ref": "#/$defs/eventDiffBudgetOverridden" }, { "$ref": "#/$defs/eventRefactorApproved" },
    { "$ref": "#/$defs/eventLotStarted" }, { "$ref": "#/$defs/eventLotResultReported" }, { "$ref": "#/$defs/eventLotReviewed" }, { "$ref": "#/$defs/eventLotIntegrated" },
    { "$ref": "#/$defs/eventLotBlocked" }, { "$ref": "#/$defs/eventReservationReleased" }, { "$ref": "#/$defs/eventIntegrationVerified" },
    { "$ref": "#/$defs/eventConsolidatedReviewed" }, { "$ref": "#/$defs/eventCorpusClosed" }, { "$ref": "#/$defs/eventCandidateFrozen" },
    { "$ref": "#/$defs/eventAcceptanceStarted" }, { "$ref": "#/$defs/eventAcceptanceCompleted" }, { "$ref": "#/$defs/eventAcceptanceWaived" },
    { "$ref": "#/$defs/eventEvidenceCommitted" }, { "$ref": "#/$defs/eventReleaseReviewed" }, { "$ref": "#/$defs/eventDraftPrPlanned" },
    { "$ref": "#/$defs/eventDraftPrCreated" }, { "$ref": "#/$defs/eventArtifactChangeObserved" }, { "$ref": "#/$defs/eventControllerRecoveryApproved" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "nullableGitSha": { "type": ["string", "null"], "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\./)[^*?\\[\\]\\\\]+$" },
    "empty": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "reasonOnly": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } },
    "approvalWithReason": { "type": "object", "additionalProperties": false, "required": ["reason", "approved_by", "approved_at"], "properties": { "reason": { "type": "string", "minLength": 1 }, "approved_by": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "format": "date-time" } } },
    "packageInitialized": { "type": "object", "additionalProperties": false, "required": ["schema_version", "run_mode"], "properties": { "schema_version": { "const": 3 }, "run_mode": { "enum": ["live", "retrospective_attestation"] } } },
    "legacyV1Imported": {
      "type": "object", "additionalProperties": false, "required": ["source", "snapshot", "legacy_paths", "migration_status", "blockers"],
      "properties": {
        "source": { "type": "object", "additionalProperties": false, "required": ["factory_state_sha256", "technical_plan_sha256"], "properties": { "factory_state_sha256": { "$ref": "#/$defs/sha256" }, "technical_plan_sha256": { "$ref": "#/$defs/sha256" } } },
        "snapshot": { "$ref": "#/$defs/legacySnapshot" },
        "legacy_paths": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } },
        "migration_status": { "const": "review_required" },
        "blockers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "legacySnapshot": {
      "type": "object", "additionalProperties": false, "required": ["version", "state", "spec", "technical_plan", "execution_policy", "gates", "lots", "tested_code_sha", "evidence_commit_sha"],
      "properties": {
        "version": { "const": 1 }, "state": { "type": "string", "minLength": 1 },
        "spec": { "$ref": "#/$defs/legacyApproval" }, "technical_plan": { "$ref": "#/$defs/legacyApproval" },
        "execution_policy": { "type": "object", "additionalProperties": false, "required": ["mode", "catalogue_observed_at", "advanced_model", "bounded_implementation_model", "reviewer_model"], "properties": { "mode": { "$ref": "#/$defs/nullableString" }, "catalogue_observed_at": { "$ref": "#/$defs/nullableString" }, "advanced_model": { "$ref": "#/$defs/nullableString" }, "bounded_implementation_model": { "$ref": "#/$defs/nullableString" }, "reviewer_model": { "$ref": "#/$defs/nullableString" } } },
        "gates": { "type": "object", "additionalProperties": false, "required": ["implementation", "consolidated_review", "corpus_closeout", "acceptance", "final_release_readiness"], "properties": { "implementation": { "$ref": "#/$defs/nullableString" }, "consolidated_review": { "$ref": "#/$defs/nullableString" }, "corpus_closeout": { "$ref": "#/$defs/nullableString" }, "acceptance": { "$ref": "#/$defs/nullableString" }, "final_release_readiness": { "$ref": "#/$defs/nullableString" } } },
        "lots": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["status", "model_planned", "model_requested", "model_used"], "properties": { "status": { "$ref": "#/$defs/nullableString" }, "model_planned": { "$ref": "#/$defs/nullableString" }, "model_requested": { "$ref": "#/$defs/nullableString" }, "model_used": { "$ref": "#/$defs/nullableString" } } } },
        "tested_code_sha": { "$ref": "#/$defs/nullableGitSha" }, "evidence_commit_sha": { "$ref": "#/$defs/nullableGitSha" }
      }
    },
    "nullableString": { "type": ["string", "null"] },
    "legacyApproval": { "type": "object", "additionalProperties": false, "required": ["status", "approved_by", "approved_at"], "properties": { "status": { "$ref": "#/$defs/nullableString" }, "approved_by": { "$ref": "#/$defs/nullableString" }, "approved_at": { "$ref": "#/$defs/nullableString" } } },
    "specProposal": { "type": "object", "additionalProperties": false, "required": ["spec_sha256"], "properties": { "spec_sha256": { "$ref": "#/$defs/sha256" } } },
    "specApproval": { "type": "object", "additionalProperties": false, "required": ["spec_sha256", "approved_by", "approved_at"], "properties": { "spec_sha256": { "$ref": "#/$defs/sha256" }, "approved_by": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "format": "date-time" } } },
    "planProposal": { "type": "object", "additionalProperties": false, "required": ["plan_sha256"], "properties": { "plan_sha256": { "$ref": "#/$defs/sha256" } } },
    "planApproval": { "type": "object", "additionalProperties": false, "required": ["plan_sha256", "approved_by", "approved_at"], "properties": { "plan_sha256": { "$ref": "#/$defs/sha256" }, "approved_by": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "format": "date-time" } } },
    "modelFamilyMap": { "type": "object", "additionalProperties": false, "required": ["economy", "standard", "expert", "reviewer"], "properties": { "economy": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "standard": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "expert": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "reviewer": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" } } },
    "executionPolicy": { "type": "object", "additionalProperties": false, "required": ["mode", "observed_at", "models", "model_families"], "properties": { "mode": { "enum": ["balanced", "maximum_quality", "economical", "manual"] }, "observed_at": { "type": "string", "format": "date-time" }, "models": { "type": "object", "additionalProperties": false, "required": ["economy", "standard", "expert", "reviewer"], "properties": { "economy": { "type": "string", "minLength": 1 }, "standard": { "type": "string", "minLength": 1 }, "expert": { "type": "string", "minLength": 1 }, "reviewer": { "type": "string", "minLength": 1 } } }, "model_families": { "$ref": "#/$defs/modelFamilyMap" } } },
    "preimplementationConventionContract": { "type": "object", "additionalProperties": false, "required": ["algorithm", "source_revision", "observed_conventions", "contract_sha256"], "properties": { "algorithm": { "const": "sha256-canonical-json-v1" }, "source_revision": { "$ref": "#/$defs/gitSha" }, "observed_conventions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observedConvention" } }, "contract_sha256": { "$ref": "#/$defs/sha256" } } },
    "waveReserved": { "type": "object", "additionalProperties": false, "required": ["reservations"], "properties": { "reservations": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["reservation_id", "lot_id"], "properties": { "reservation_id": { "type": "string", "minLength": 1 }, "lot_id": { "type": "string", "minLength": 1 } } } } } },
    "reservationReference": { "type": "object", "additionalProperties": false, "required": ["reservation_id"], "properties": { "reservation_id": { "type": "string", "minLength": 1 } } },
    "workspaceEntry": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["path", "origin", "status", "sha256"], "properties": { "path": { "$ref": "#/$defs/repoPath" }, "origin": { "enum": ["tracked", "untracked"] }, "status": { "const": "present" }, "sha256": { "$ref": "#/$defs/sha256" } } }, { "type": "object", "additionalProperties": false, "required": ["path", "origin", "status"], "properties": { "path": { "$ref": "#/$defs/repoPath" }, "origin": { "const": "tracked" }, "status": { "const": "deleted" }, "sha256": { "type": "null" } } }] },
    "workspaceSnapshot": { "type": "object", "additionalProperties": false, "required": ["v", "algorithm", "workspace_id", "workspace_mode", "attestation_mode", "base_revision", "exclusions", "entries", "snapshot_sha256"], "properties": { "v": { "const": 1 }, "algorithm": { "const": "sha256-git-dirty-snapshot-v1" }, "workspace_id": { "$ref": "#/$defs/sha256" }, "workspace_mode": { "enum": ["repository", "isolated_worktree"] }, "attestation_mode": { "enum": ["live", "retrospective_attestation"] }, "base_revision": { "$ref": "#/$defs/gitSha" }, "exclusions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repoPath" } }, "entries": { "type": "array", "items": { "$ref": "#/$defs/workspaceEntry" } }, "snapshot_sha256": { "$ref": "#/$defs/sha256" } } },
    "changeMetrics": { "type": "object", "additionalProperties": false, "required": ["algorithm", "files", "added_lines", "deleted_lines", "binary_files"], "properties": { "algorithm": { "const": "git-numstat-plus-untracked-v1" }, "files": { "type": "integer", "minimum": 0 }, "added_lines": { "type": "integer", "minimum": 0 }, "deleted_lines": { "type": "integer", "minimum": 0 }, "binary_files": { "type": "integer", "minimum": 0 } } },
    "diffBudgetProof": { "type": "object", "additionalProperties": false, "required": ["source", "max_files", "max_added_lines", "max_deleted_lines", "max_binary_files", "override_event_id"], "properties": { "source": { "enum": ["policy_default", "operator_override"] }, "max_files": { "type": "integer", "minimum": 1 }, "max_added_lines": { "type": "integer", "minimum": 1 }, "max_deleted_lines": { "type": "integer", "minimum": 1 }, "max_binary_files": { "type": "integer", "minimum": 0 }, "override_event_id": { "type": ["string", "null"], "pattern": "^EVT-[0-9]{6,}$" } } },
    "workspaceDelta": { "type": "object", "additionalProperties": false, "required": ["algorithm", "from_snapshot_sha256", "to_snapshot", "files_sha256", "metrics", "budget"], "properties": { "algorithm": { "const": "sha256-git-workspace-delta-v1" }, "from_snapshot_sha256": { "$ref": "#/$defs/sha256" }, "to_snapshot": { "$ref": "#/$defs/workspaceSnapshot" }, "files_sha256": { "$ref": "#/$defs/sha256" }, "metrics": { "$ref": "#/$defs/changeMetrics" }, "budget": { "$ref": "#/$defs/diffBudgetProof" } } },
    "lotStarted": { "type": "object", "additionalProperties": false, "required": ["reservation_id", "workspace_snapshot"], "properties": { "reservation_id": { "type": "string", "minLength": 1 }, "workspace_snapshot": { "$ref": "#/$defs/workspaceSnapshot" } } },
    "fileDigest": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["path", "status", "sha256"], "properties": { "path": { "$ref": "#/$defs/repoPath" }, "status": { "const": "present" }, "sha256": { "$ref": "#/$defs/sha256" } } }, { "type": "object", "additionalProperties": false, "required": ["path", "status"], "properties": { "path": { "$ref": "#/$defs/repoPath" }, "status": { "const": "deleted" }, "sha256": { "type": "null" } } }] },
    "outputDigest": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["id", "path", "kind", "algorithm", "sha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "path": { "$ref": "#/$defs/repoPath" }, "kind": { "const": "file" }, "algorithm": { "const": "sha256-file-bytes-v1" }, "sha256": { "$ref": "#/$defs/sha256" } } }, { "type": "object", "additionalProperties": false, "required": ["id", "path", "kind", "algorithm", "sha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "path": { "$ref": "#/$defs/repoPath" }, "kind": { "const": "tree" }, "algorithm": { "const": "sha256-tree-inventory-v1" }, "sha256": { "$ref": "#/$defs/sha256" } } }] },
    "byteReference": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": { "path": { "$ref": "#/$defs/repoPath" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 } } },
    "verificationRunner": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "version", "attestation_ref"], "properties": { "kind": { "enum": ["controller_observed", "protected_ci"] }, "id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 }, "attestation_ref": { "type": "string", "minLength": 1 } } },
    "verificationDigest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "id", "command", "status", "runner", "exit_code", "stdout", "stderr", "artifacts", "receipt_sha256"], "properties": { "algorithm": { "const": "sha256-verification-receipt-v1" }, "id": { "type": "string", "minLength": 1 }, "command": { "type": "string", "minLength": 1 }, "status": { "const": "passed" }, "runner": { "$ref": "#/$defs/verificationRunner" }, "exit_code": { "const": 0 }, "stdout": { "$ref": "#/$defs/byteReference" }, "stderr": { "$ref": "#/$defs/byteReference" }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/byteReference" } }, "receipt_sha256": { "$ref": "#/$defs/sha256" } } },
    "observedConvention": { "type": "object", "additionalProperties": false, "required": ["id", "rule", "examples"], "properties": { "id": { "type": "string", "minLength": 1 }, "rule": { "type": "string", "minLength": 1 }, "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/byteReference" } } } },
    "operatorDecision": { "type": "object", "additionalProperties": false, "required": ["decision", "reason", "approved_by", "approved_at"], "properties": { "decision": { "const": "approved" }, "reason": { "type": "string", "minLength": 1 }, "approved_by": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "format": "date-time" } } },
    "refactorAssessment": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": { "status": { "const": "not_required" }, "reason": { "type": "string", "minLength": 1 } } },
      { "type": "object", "additionalProperties": false, "required": ["status", "locations", "evidence", "why_blocking", "smallest_refactor", "alternatives", "blast_radius", "tests", "amendment_ref", "escalation_event_id", "approval_event_id"], "properties": { "status": { "const": "approved" }, "locations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/byteReference" } }, "why_blocking": { "type": "string", "minLength": 1 }, "smallest_refactor": { "type": "string", "minLength": 1 }, "alternatives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "blast_radius": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "amendment_ref": { "type": "string", "minLength": 1 }, "escalation_event_id": { "type": "string", "pattern": "^EVT-[0-9]{6,}$" }, "approval_event_id": { "type": "string", "pattern": "^EVT-[0-9]{6,}$" } } }
    ] },
    "refactorEscalation": { "type": "object", "additionalProperties": false, "required": ["locations", "evidence", "why_blocking", "smallest_refactor", "alternatives", "blast_radius", "tests"], "properties": { "locations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/byteReference" } }, "why_blocking": { "type": "string", "minLength": 1 }, "smallest_refactor": { "type": "string", "minLength": 1 }, "alternatives": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "blast_radius": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "lotBlocked": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 }, "refactor_escalation": { "$ref": "#/$defs/refactorEscalation" } } },
    "lotResultReported": { "type": "object", "additionalProperties": false, "required": ["result"], "properties": { "result": { "$ref": "#/$defs/lotResult" } } },
    "lotResult": { "type": "object", "additionalProperties": false, "required": ["algorithm", "base_revision", "changed_paths", "files", "workspace_delta", "diff_sha256", "outputs", "verification", "preimplementation_contract_sha256", "observed_conventions", "refactor_assessment", "blockers"], "properties": { "algorithm": { "const": "sha256-canonical-json-v1" }, "base_revision": { "$ref": "#/$defs/gitSha" }, "changed_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/repoPath" } }, "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileDigest" } }, "workspace_delta": { "$ref": "#/$defs/workspaceDelta" }, "diff_sha256": { "$ref": "#/$defs/sha256" }, "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outputDigest" } }, "verification": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verificationDigest" } }, "preimplementation_contract_sha256": { "$ref": "#/$defs/sha256" }, "observed_conventions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observedConvention" } }, "refactor_assessment": { "$ref": "#/$defs/refactorAssessment" }, "blockers": { "type": "array", "maxItems": 0 } } },
    "reviewResolution": { "type": "object", "additionalProperties": false, "required": ["diff_sha256", "evidence_sha256", "reviewed_at"], "properties": { "diff_sha256": { "$ref": "#/$defs/sha256" }, "evidence_sha256": { "$ref": "#/$defs/sha256" }, "reviewed_at": { "type": "string", "format": "date-time" } } },
    "reviewWaiver": { "type": "object", "additionalProperties": false, "required": ["reason", "approved_by", "approved_at", "finding_sha256", "diff_sha256", "plan_sha256"], "properties": { "reason": { "type": "string", "minLength": 1 }, "approved_by": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "format": "date-time" }, "finding_sha256": { "$ref": "#/$defs/sha256" }, "diff_sha256": { "$ref": "#/$defs/sha256" }, "plan_sha256": { "$ref": "#/$defs/sha256" } } },
    "reviewFinding": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["id", "severity", "rule", "location", "evidence", "impact", "status"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }, "severity": { "enum": ["P0", "P1", "P2", "P3"] }, "rule": { "type": "string", "minLength": 1 }, "location": { "type": "string", "minLength": 1 }, "evidence": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 }, "status": { "const": "open" } } },
